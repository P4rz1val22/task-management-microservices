        {
          "name": "List All Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tasks routed to Task Service successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property('tasks');",
                  "    ",
                  "    // Verify enriched data from cross-service calls",
                  "    if (pm.response.json().tasks.length > 0) {",
                  "        const task = pm.response.json().tasks[0];",
                  "        pm.expect(task).to.have.property('project');",
                  "        pm.expect(task.project).to.have.property('name');",
                  "        pm.expect(task).to.have.property('creator');",
                  "        pm.expect(task).to.have.property('assignee');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/tasks",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "tasks"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter Tasks by Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Task filtering works correctly', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property('tasks');",
                  "    const tasks = pm.response.json().tasks;",
                  "",
                  "    // Every task returned must match the status that was queried.",
                  "    tasks.forEach(function (task) {",
                  "        pm.expect(task.status).to.eql('In Progress');",
                  "    });",
                  "",
                  "    // And the filter must actually be doing work: the task created",
                  "    // earlier in this run is 'In Progress', so it has to come back.",
                  "    // Without this the assertion above passes on an empty list.",
                  "    const ids = tasks.map(function (task) { return task.id; });",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('task_id')));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/tasks?status=In Progress",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "In Progress"
                }
              ]
            }
          },
          "response": []
        },
