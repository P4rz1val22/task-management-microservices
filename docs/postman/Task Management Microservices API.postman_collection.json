    {
      "name": "Authentication (via Gateway)",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// The collection must be re-runnable against a database it has already",
                  "// touched. A hardcoded email 409s on the second run, so mint a fresh one",
                  "// per run and let Login User reuse it via the same collection variable.",
                  "const stamp = Date.now() + '-' + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('test_email', 'microservices-' + stamp + '@test.com');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration successful', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json()).to.have.property('token');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('auth_token', pm.response.json().token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Microservices Tester\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth/register",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
