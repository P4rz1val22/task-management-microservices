        {
          "name": "Create Project",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Project names are unique, so a hardcoded name 409s on a re-run and",
                  "// leaves project_id empty, which cascades into every task request below.",
                  "const stamp = Date.now() + '-' + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set('test_project_name', 'Microservices Test Project ' + stamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().project).to.have.property('id');",
                  "    pm.expect(pm.response.json().project.name).to.eql(pm.collectionVariables.get('test_project_name'));",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('project_id', pm.response.json().project.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
